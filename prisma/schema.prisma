generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
  binaryTargets   = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

enum Role {
  BUYER
  OWNER
  PARTNER_AGENT
  INTERNAL_AGENT
  SURVEYOR
  PHOTOGRAPHER
  ADMIN
  SUPER_ADMIN
}

model User {
  id              String    @id @default(uuid())
  email           String    @unique
  phone           String?   @unique
  name            String
  image           String?
  address         String?
  role            Role      @default(BUYER)
  passwordHash    String?   @map("password_hash")
  isEmailVerified Boolean   @default(false) @map("is_email_verified")
  isDeleted       Boolean   @default(false) @map("is_deleted")
  termsAcceptedAt DateTime? @map("terms_accepted_at") @db.Timestamptz()
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz()
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz()

  properties             Property[]
  bookings               Booking[]
  verificationAudits     VerificationAudit[]
  accounts               Account[]
  auditLogs              AuditLog[]
  savedProperties        SavedProperty[]
  leads                  Lead[]
  articles               Article[]
  savedSearches          SavedSearch[]
  offersSent             Offer[]                @relation("OffersSent")
  offersReceived         Offer[]                @relation("OffersReceived")
  documents              Document[]
  messagesSent           Message[]              @relation("MessagesSent")
  messagesReceived       Message[]              @relation("MessagesReceived")
  surveyTasks            SurveyTask[]           @relation("SurveyTasks")
  commissions            Commission[]           @relation("AgentCommissions")
  notifications          Notification[]
  subscription           Subscription?
  invoices               Invoice[]
  mediaUploads           Media[]                @relation("MediaUploader")
  couponUsages           CouponUsage[]
  tickets                Ticket[]
  ownerVerification      OwnerVerification?
  internalTasks          Task[]                 @relation("InternalTasks")
  photographerTasks      PhotographerTask[]     @relation("PhotographerTasks")
  photographerDeliveries PhotographerDelivery[] @relation("PhotographerDeliveries")
  partnerProfile         PartnerAgentProfile?

  @@map("users")
}

model Property {
  id           String                       @id @default(uuid())
  ownerId      String
  slug         String                       @unique
  title        String
  description  String
  price        Decimal                      @db.Decimal(15, 2)
  propertyType String
  bedrooms     Int?
  bathrooms    Int?
  surfaceArea  Float?
  buildingArea Float?
  status       PropertyStatus               @default(DRAFT)
  address      String
  latitude     Float
  longitude    Float
  embedding    Unsupported("vector(1536)")?
  isDeleted    Boolean                      @default(false)
  createdAt    DateTime                     @default(now())
  updatedAt    DateTime                     @updatedAt

  owner                  User                   @relation(fields: [ownerId], references: [id]) // Default: RESTRICT (Soft-delete via isDeleted)
  agentId                String?
  agentProfile           PartnerAgentProfile?   @relation("AgentProperties", fields: [agentId], references: [id])
  media                  PropertyMedia[]
  bookings               Booking[]
  verificationAudits     VerificationAudit[]
  savedProperties        SavedProperty[]
  viewLogs               PropertyViewLog[]
  leads                  Lead[]
  offers                 Offer[]
  documents              Document[]
  surveyTasks            SurveyTask[]
  photographerTasks      PhotographerTask[]
  photographerDeliveries PhotographerDelivery[]

  @@index([ownerId])
  @@index([status, price])
}

model PropertyMedia {
  id         String   @id @default(uuid())
  propertyId String
  mediaType  String
  s3Url      String
  isPrimary  Boolean  @default(false)
  isDeleted  Boolean  @default(false)
  createdAt  DateTime @default(now())

  property Property @relation(fields: [propertyId], references: [id])

  @@index([propertyId])
}

model Booking {
  id         String        @id @default(uuid())
  propertyId String
  buyerId    String
  surveyDate DateTime
  timeSlot   String
  status     BookingStatus @default(PENDING)
  isDeleted  Boolean       @default(false)
  createdAt  DateTime      @default(now())

  property    Property     @relation(fields: [propertyId], references: [id]) // Default: RESTRICT
  buyer       User         @relation(fields: [buyerId], references: [id]) // Default: RESTRICT
  commissions Commission[]

  @@index([propertyId])
  @@index([buyerId])
}

model VerificationAudit {
  id         String   @id @default(uuid())
  propertyId String
  surveyorId String
  action     String
  notes      String?
  createdAt  DateTime @default(now())

  property Property @relation(fields: [propertyId], references: [id])
  surveyor User     @relation(fields: [surveyorId], references: [id])

  @@index([propertyId])
  @@index([surveyorId])
}

model Account {
  id                String   @id @default(uuid())
  userId            String   @map("user_id")
  type              String
  provider          String
  providerAccountId String   @map("provider_account_id")
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz()

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model AuditLog {
  id        String   @id @default(uuid())
  actorId   String
  action    String
  entityId  String
  oldValues String?
  newValues String?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  actor User @relation(fields: [actorId], references: [id])

  @@index([actorId])
  @@index([entityId])
}

model SavedProperty {
  id         String   @id @default(uuid())
  buyerId    String
  propertyId String
  createdAt  DateTime @default(now())

  buyer    User     @relation(fields: [buyerId], references: [id])
  property Property @relation(fields: [propertyId], references: [id])

  @@unique([buyerId, propertyId])
  @@index([buyerId])
  @@index([propertyId])
}

model PropertyViewLog {
  id         String   @id @default(uuid())
  propertyId String
  viewerId   String? // Nullable for anonymous guests
  viewedAt   DateTime @default(now())
  source     String   @default("DIRECT_LINK") // e.g. SEARCH_RESULT, DIRECT_LINK, RECOMMENDATION

  property Property @relation(fields: [propertyId], references: [id])
  // Optional: viewer User? @relation(fields: [viewerId], references: [id])

  @@index([propertyId])
  @@index([viewerId])
}

model Lead {
  id              String   @id @default(uuid())
  propertyId      String
  buyerId         String
  interactionType String // e.g. BOOKMARK, CHAT_MESSAGE, DETAIL_VIEW
  followUpStatus  String   @default("PENDING") // PENDING, CONTACTED, CLOSED
  createdAt       DateTime @default(now())

  property Property @relation(fields: [propertyId], references: [id])
  buyer    User     @relation(fields: [buyerId], references: [id])

  @@index([propertyId])
  @@index([buyerId])
  @@index([followUpStatus])
}

model Category {
  id        String    @id @default(uuid())
  name      String    @unique
  slug      String    @unique
  createdAt DateTime  @default(now())
  articles  Article[]
}

model Article {
  id         String   @id @default(uuid())
  title      String
  slug       String   @unique
  content    String
  status     String   @default("DRAFT") // DRAFT, PUBLISHED
  categoryId String?
  authorId   String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  category Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  author   User      @relation(fields: [authorId], references: [id])

  @@index([categoryId])
  @@index([authorId])
}

model VerificationToken {
  id         String   @id @default(uuid())
  identifier String
  token      String   @unique
  expires    DateTime @db.Timestamptz()
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz()

  @@unique([identifier, token])
  @@index([identifier])
  @@map("verification_tokens")
}

model PasswordResetToken {
  id         String   @id @default(uuid())
  identifier String
  token      String   @unique
  expires    DateTime @db.Timestamptz()
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz()

  @@unique([identifier, token])
  @@index([identifier])
  @@map("password_reset_tokens")
}

model SavedSearch {
  id        String   @id @default(uuid())
  userId    String
  query     String
  name      String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
}

model Offer {
  id         String      @id @default(uuid())
  propertyId String
  buyerId    String
  ownerId    String
  amount     Decimal     @db.Decimal(15, 2)
  status     OfferStatus @default(PENDING) // PENDING, ACCEPTED, REJECTED, COUNTERED
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  property Property @relation(fields: [propertyId], references: [id])
  buyer    User     @relation("OffersSent", fields: [buyerId], references: [id])
  owner    User     @relation("OffersReceived", fields: [ownerId], references: [id])

  @@index([propertyId])
  @@index([buyerId])
  @@index([ownerId])
}

model Document {
  id           String   @id @default(uuid())
  propertyId   String?
  userId       String
  title        String
  fileUrl      String
  documentType String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  property Property? @relation(fields: [propertyId], references: [id])
  user     User      @relation(fields: [userId], references: [id])

  @@index([propertyId])
  @@index([userId])
}

model Message {
  id         String   @id @default(uuid())
  senderId   String
  receiverId String
  content    String
  isRead     Boolean  @default(false)
  createdAt  DateTime @default(now())

  sender   User @relation("MessagesSent", fields: [senderId], references: [id])
  receiver User @relation("MessagesReceived", fields: [receiverId], references: [id])

  @@index([senderId])
  @@index([receiverId])
}

model SurveyTask {
  id          String    @id @default(uuid())
  propertyId  String
  surveyorId  String
  status      String    @default("PENDING") // PENDING, IN_PROGRESS, COMPLETED, CANCELLED
  scheduledAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  property Property      @relation(fields: [propertyId], references: [id])
  surveyor User          @relation("SurveyTasks", fields: [surveyorId], references: [id])
  report   SurveyReport?

  @@index([propertyId])
  @@index([surveyorId])
}

model SurveyReport {
  id           String   @id @default(uuid())
  surveyTaskId String   @unique
  notes        String?
  documentsUrl String[]
  isApproved   Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  surveyTask SurveyTask @relation(fields: [surveyTaskId], references: [id])

  @@index([surveyTaskId])
}

// ─── MVP2 Models ─────────────────────────────────────────────────────────────

model Commission {
  id         String   @id @default(uuid())
  bookingId  String
  agentId    String
  invoiceId  String?
  percentage Decimal  @db.Decimal(5, 2)
  amount     Decimal  @db.Decimal(15, 2)
  status     String   @default("PENDING") // PENDING | PAID
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  booking Booking  @relation(fields: [bookingId], references: [id])
  agent   User     @relation("AgentCommissions", fields: [agentId], references: [id])
  invoice Invoice? @relation(fields: [invoiceId], references: [id])

  @@index([bookingId])
  @@index([agentId])
  @@index([invoiceId])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  body      String
  type      String // e.g. SYSTEM, BOOKING, LEAD, BILLING
  isRead    Boolean  @default(false)
  relatedId String? // Optional ID of related entity
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([userId, isRead])
}

model NotificationTemplate {
  id        String   @id @default(uuid())
  name      String   @unique
  subject   String
  bodyHtml  String
  channel   String // EMAIL | SMS | IN_APP
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Subscription {
  id        String    @id @default(uuid())
  userId    String    @unique
  plan      String
  status    String    @default("ACTIVE") // ACTIVE | INACTIVE | CANCELLED
  startDate DateTime
  endDate   DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user     User      @relation(fields: [userId], references: [id])
  invoices Invoice[]

  @@index([userId])
}

model Invoice {
  id             String        @id @default(uuid())
  userId         String
  subscriptionId String?
  couponUsages   CouponUsage[]
  commissions    Commission[]
  amount         Decimal       @db.Decimal(15, 2)
  status         String        @default("PENDING") // PENDING | PAID | CANCELLED
  paidAt         DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  user         User          @relation(fields: [userId], references: [id])
  subscription Subscription? @relation(fields: [subscriptionId], references: [id])

  @@index([userId])
  @@index([subscriptionId])
}

model Testimonial {
  id          String   @id @default(uuid())
  authorName  String
  authorRole  String
  content     String
  rating      Int
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
}

model Banner {
  id        String   @id @default(uuid())
  title     String
  imageUrl  String
  linkUrl   String?
  isActive  Boolean  @default(true)
  position  String // e.g. HOME_TOP, HOME_BOTTOM, SIDEBAR
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Media {
  id           String   @id @default(uuid())
  url          String
  fileType     String
  altText      String?
  uploadedById String
  createdAt    DateTime @default(now())

  uploadedBy User @relation("MediaUploader", fields: [uploadedById], references: [id])

  @@index([uploadedById])
}

model StaticPage {
  id              String   @id @default(uuid())
  slug            String   @unique
  title           String
  contentHtml     String
  metaDescription String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model FAQ {
  id        String   @id @default(uuid())
  question  String
  answer    String
  isActive  Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Coupon {
  id         String    @id @default(uuid())
  code       String    @unique
  discount   Decimal   @db.Decimal(15, 2) // percentage or fixed amount
  type       String    @default("PERCENTAGE") // PERCENTAGE | FIXED
  maxUses    Int?
  usedCount  Int       @default(0)
  validFrom  DateTime?
  validUntil DateTime?
  isActive   Boolean   @default(true)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  usages CouponUsage[]
}

model CouponUsage {
  id              String   @id @default(uuid())
  couponId        String
  userId          String
  invoiceId       String?
  discountApplied Decimal?
  usedAt          DateTime @default(now())

  coupon  Coupon   @relation(fields: [couponId], references: [id])
  user    User     @relation(fields: [userId], references: [id])
  invoice Invoice? @relation(fields: [invoiceId], references: [id])

  @@unique([couponId, userId])
  @@index([couponId])
  @@index([userId])
  @@index([invoiceId])
}

// ─── Phase 4 Models ──────────────────────────────────────────────────────────

enum TicketStatus {
  OPEN
  IN_PROGRESS
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
}

enum TicketCategory {
  PAYMENT
  TECHNICAL
  ACCOUNT
  OTHER
}

model Ticket {
  id          String         @id @default(uuid())
  userId      String
  subject     String
  description String?
  status      TicketStatus   @default(OPEN)
  priority    TicketPriority @default(MEDIUM)
  category    TicketCategory @default(OTHER)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
}

enum PropertyStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  REJECTED
  ARCHIVED
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum OfferStatus {
  PENDING
  ACCEPTED
  REJECTED
  COUNTERED
}

enum IdType {
  KTP
  PASPOR
}

enum VerificationStatus {
  UNVERIFIED
  APPROVED
  REJECTED
}

model OwnerVerification {
  id          String             @id @default(uuid())
  userId      String             @unique
  idType      IdType
  idNumber    String             @unique
  documentUrl String?
  status      VerificationStatus @default(UNVERIFIED)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  user User @relation(fields: [userId], references: [id])
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
  OVERDUE
}

enum TaskType {
  VERIFICATION
  FINANCE
  MODERATION
  HR
  SUPPORT
}

model Task {
  id          String     @id @default(uuid())
  title       String
  description String?
  assigneeId  String
  dueDate     DateTime?
  status      TaskStatus @default(TODO)
  type        TaskType   @default(SUPPORT)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  assignee User @relation("InternalTasks", fields: [assigneeId], references: [id])

  @@index([assigneeId])
  @@index([status])
  @@index([dueDate])
}

enum PhotographerTaskStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
}

model PhotographerTask {
  id             String                 @id @default(uuid())
  propertyId     String
  photographerId String
  status         PhotographerTaskStatus @default(PENDING)
  scheduledAt    DateTime?
  notes          String?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  property     Property @relation(fields: [propertyId], references: [id])
  photographer User     @relation("PhotographerTasks", fields: [photographerId], references: [id])

  @@index([photographerId, status])
}

enum DeliveryStatus {
  PENDING
  READY
  DELIVERED
}

model PhotographerDelivery {
  id             String         @id @default(uuid())
  propertyId     String
  photographerId String
  status         DeliveryStatus @default(PENDING)
  mediaCount     Int            @default(0)
  shootDate      DateTime
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  property     Property @relation(fields: [propertyId], references: [id])
  photographer User     @relation("PhotographerDeliveries", fields: [photographerId], references: [id])

  @@index([photographerId, status])
}

model SystemConfig {
  id          String   @id @default(uuid())
  key         String   @unique
  value       String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model WebhookEvent {
  id          String    @id @default(uuid())
  eventType   String
  payload     Json
  status      String    @default("PENDING") // PENDING | PROCESSED | FAILED
  createdAt   DateTime  @default(now())
  processedAt DateTime?
}

// ─── Partner Agent (Phase 4) ─────────────────────────────────────────────────

model Agency {
  id        String   @id @default(uuid())
  name      String
  address   String?
  phone     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  agents PartnerAgentProfile[]
}

model PartnerAgentProfile {
  id        String   @id @default(uuid())
  userId    String   @unique
  agencyId  String?
  licenseNo String?
  bio       String?
  rating    Decimal  @default(0.00) @db.Decimal(3, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user       User          @relation(fields: [userId], references: [id])
  agency     Agency?       @relation(fields: [agencyId], references: [id])
  clients    AgentClient[]
  properties Property[]    @relation("AgentProperties")
}

model AgentClient {
  id        String   @id @default(uuid())
  agentId   String
  name      String
  email     String?
  phone     String?
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  agent PartnerAgentProfile @relation(fields: [agentId], references: [id])

  @@index([agentId])
}
